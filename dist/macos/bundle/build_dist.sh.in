#!/bin/sh

# Use the same verbose variable as CMake
[ "$VERBOSE" = "1" ] && set -x

# Exit on unset variables or pipe errors
set -uo pipefail

B_VERSION="@INPUTLEAP_VERSION@"
B_BINDIR="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@"
B_BUILDTYPE="@CMAKE_BUILD_TYPE@"
B_TEMPLATE_APP="@INPUTLEAP_BUNDLE_TEMPLATE_APP_DIR@"
B_APP="InputLeafPlus.app"
B_STAGING_APP=".InputLeafPlus.building.app"
B_MACOS="$B_STAGING_APP/Contents/MacOS"
B_INPUTLEAPC="$B_MACOS/input-leapc"
B_INPUTLEAPS="$B_MACOS/input-leaps"

# Colorized output
info() { tput bold 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true; }
error() { tput bold 2>/dev/null || true; tput setaf 1 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true; }
success() { tput bold 2>/dev/null || true; tput setaf 2 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true; }
warn() { tput bold 2>/dev/null || true; tput setaf 3 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true; }

info "Checking for bundle template"
if [ ! -d "$B_TEMPLATE_APP/Contents" ]; then
    error "Please make sure that the build completed successfully"
    error "before trying to create the installer."
    exit 1
fi

app_is_running() {
    pgrep -f "$PWD/$B_APP/Contents/MacOS/input-leap" >/dev/null 2>&1
}

if app_is_running; then
    error "Close the InputLeafPlus app from this build folder before rebuilding."
    exit 1
fi

if [ -e "$B_STAGING_APP" ]; then
    info "Removing incomplete staging bundle"
    rm -rf "$B_STAGING_APP" || exit 1
fi

info "Preparing staging bundle"
cp -R "$B_TEMPLATE_APP" "$B_STAGING_APP" || exit 1

info "Copying binaries into staging bundle"
# Copy the folder instead of globbing unquoted path
cp -r "$B_BINDIR" "$B_MACOS" || exit 1

DEPLOYQT=@QT_DEPLOY_TOOL@

# Use macdeployqt to include libraries. Sign only after all binaries have been
# copied and adjusted, otherwise macOS can reject modified library pages.
if [ "$B_BUILDTYPE" = "Release" ]; then
    info "Building Release bundle"
    "$DEPLOYQT" "$B_STAGING_APP" -no-codesign \
        -executable="$B_INPUTLEAPC" \
        -executable="$B_INPUTLEAPS" || exit 1
else
    warn "Disk image (dmg) only created for Release builds"
    info "Building debug bundle"
    "$DEPLOYQT" "$B_STAGING_APP" -no-strip -no-codesign \
        -executable="$B_INPUTLEAPC" \
        -executable="$B_INPUTLEAPS" || exit 1
fi

info "Signing application bundle"
codesign --force --deep --sign - "$B_STAGING_APP" || exit 1
codesign --verify --deep --strict --verbose=2 "$B_STAGING_APP" || exit 1

# Keep the last working app available until the replacement is fully signed.
if app_is_running; then
    error "InputLeafPlus was opened during the build. Close it and build again."
    exit 1
fi
rm -rf "$B_APP" || exit 1
mv "$B_STAGING_APP" "$B_APP" || exit 1
codesign --verify --deep --strict --verbose=2 "$B_APP" || exit 1

if [ "$B_BUILDTYPE" = "Release" ]; then
    B_DMG="InputLeafPlus-$B_VERSION.dmg"
    info "Building Release disk image (dmg)"
    hdiutil create -fs HFS+ -format UDZO -volname "InputLeafPlus" \
        -srcfolder "$B_APP" -ov "$B_DMG" || exit 1
    success "Created $B_DMG"
else
    success "Bundle created successfully"
fi
