<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleDisplayName</key>
    <string>InputLeafPlus</string>
    <key>CFBundleExecutable</key>
    <string>input-leap</string>
    <key>CFBundleIconFile</key>
    <string>InputLeap.icns</string>
    <key>CFBundleIdentifier</key>
    <string>input-leap</string>
    <!-- TODO: Fix this in v2.0 //-->
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>InputLeafPlus</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>SYN1</string>
    <key>CFBundleShortVersionString</key>
    <string>@INPUTLEAP_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@INPUTLEAP_VERSION@</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <string>True</string>
    <key>NSHumanReadableCopyright</key>
    <string>© InputLeap contributors</string>
    <key>NSInputMonitoringUsageDescription</key>
    <string>지정한 USB 키보드를 Mac에서만 사용하려면 키보드 입력 확인 권한이 필요합니다.</string>
    <key>LSMinimumSystemVersion</key>
    <string>10.12.0</string>
  </dict>
</plist>
